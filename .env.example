# KhedutMitra Environment Variables
# Copy this file to .env and fill in values

# ── Frontend (safe to expose) ──────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3001/api

# ── Backend (server-side only) ─────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
AGMARKNET_API_KEY=

# ── AI/ML Providers (server-side only) ─────────────────────────
AI_ADVICE_API_KEY=
AI_ADVICE_BASE_URL=
DISEASE_API_URL=
DISEASE_API_KEY=

# ── Server ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
